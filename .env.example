# =============================================================================
# DataScienceProfessionalPortfolio - Environment Variables Template
# =============================================================================
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# The `.env` file is excluded from version control by `.gitignore`.
# NEVER commit real credentials, API keys, or secrets to the repository.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Application environment: development | staging | production
APP_ENV=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Optional path to a log file. Leave empty to log to stderr only.
LOG_FILE=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLAlchemy-compatible connection string.
# Examples:
#   SQLite:     sqlite:///./data/local.db
#   PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/mydb
DATABASE_URL=sqlite:///./data/local.db

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------
# Base URL and credentials for external data sources (if applicable).
API_BASE_URL=
API_KEY=
API_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Data Paths
# -----------------------------------------------------------------------------
# Directory layout for raw, interim, and processed data.
DATA_RAW_DIR=data/raw
DATA_INTERIM_DIR=data/interim
DATA_PROCESSED_DIR=data/processed

# Directory for generated reports and figures.
REPORTS_DIR=reports

# -----------------------------------------------------------------------------
# Machine Learning
# -----------------------------------------------------------------------------
# Random seed for reproducibility across experiments.
RANDOM_SEED=42

# -----------------------------------------------------------------------------
# Streamlit (optional)
# -----------------------------------------------------------------------------
# Port used when running Streamlit dashboards locally.
STREAMLIT_SERVER_PORT=8501